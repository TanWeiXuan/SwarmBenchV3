FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/swarmbench/src
WORKDIR /opt/swarmbench
COPY pyproject.toml /opt/swarmbench/
COPY src /opt/swarmbench/src
RUN python -m pip install --no-cache-dir --no-deps .
USER 65534:65534
ENTRYPOINT ["python", "-u", "-m", "swarmbench.controller_runner.worker"]
